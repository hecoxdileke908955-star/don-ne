    "react-dom": "19.2.8",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.41",
